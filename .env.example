# Copy to .env for local development: cp .env.example .env

# Postgres connection string (local Postgres, Docker, or Railway's DATABASE_URL)
DATABASE_URL=postgresql://mypeers:mypeers@localhost:5432/mypeers

# The site's public URL. Local dev uses the Vite server on 5173.
# In production this must be https://your-domain (secure cookies depend on it).
APP_URL=http://localhost:5173
NODE_ENV=development
PORT=4000

# Who can sign up
ALLOWED_EMAIL_DOMAIN=mail.mcgill.ca
REQUIRE_EMAIL_VERIFICATION=true

# Email: "log" prints codes in the server terminal (development).
# For production use "brevo" or "resend" with an API key and a verified sender.
EMAIL_PROVIDER=log
# EMAIL_API_KEY=
# EMAIL_FROM=you@example.com
# EMAIL_FROM_NAME=myPeers

# Uploaded chat files (mount a volume here in production)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# "Try the demo" button with sample classmates
DEMO_ENABLED=true
